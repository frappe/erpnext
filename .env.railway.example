# ============================================================================
# Kanaan ERP - Railway.com Environment Configuration Example
# ============================================================================
# نسخ هذا الملف وأعد تسميه إلى .env
# أو استخدم Railway Dashboard لتعيين المتغيرات

# ============================================================================
# تكوين Frappe/ERPNext
# ============================================================================

# البيئة (development/staging/production)
FRAPPE_ENV=production

# اسم الموقع أو النطاق
SITE_NAME=localhost

# تفعيل وضع التطويري (true/false)
DEBUG=false

# مستوى تسجيل السجلات (debug/info/warning/error/critical)
LOG_LEVEL=info

# ============================================================================
# مفاتيح التشفير (اتركها فارغة للسماح بـ Railway بإنشاءها)
# ============================================================================

# مفتاح سري لـ Frappe
# استخدم: openssl rand -base64 32
SECRET_KEY=change-this-to-a-random-32-character-string-minimum

# مفتاح التشفير للبيانات الحساسة
# استخدم: openssl rand -base64 32
ENCRYPTION_KEY=change-this-to-another-random-32-character-string

# ============================================================================
# قاعدة البيانات (Railway توفرها تلقائياً)
# ============================================================================

# Railway سيوفر DATABASE_URL تلقائياً عند إضافة MariaDB
# ولا تحتاج إلى تعيينها يدوياً إذا كنت تستخدم Railway Database

# إذا كنت تستخدم قاعدة بيانات خارجية:
# DB_HOST=your-database-host.com
# DB_PORT=3306
# DB_NAME=kanaan_erpnext
# DB_USER=erpnext
# DB_PASSWORD=your-secure-password

# ============================================================================
# Redis (Railway توفره تلقائياً)
# ============================================================================

# Railway سيوفر REDIS_URL تلقائياً عند إضافة Redis
# REDIS_URL=redis://default:password@redis-host:6379

# أو استخدم نفس الـ URL للـ Cache و Queue:
# REDIS_CACHE=redis://default:password@redis-host:6379/0
# REDIS_QUEUE=redis://default:password@redis-host:6379/1

# ============================================================================
# إعدادات التطبيق
# ============================================================================

# قائمة النطاقات المسموحة (FQDN)
ALLOW_HOSTS=localhost,127.0.0.1,*.railway.app,your-domain.com

# عدد workers الـ Gunicorn
WORKERS=4

# حجم thread pool للـ Redis
MAX_POOL_SIZE=10

# ============================================================================
# Node.js Configuration
# ============================================================================

# بيئة Node.js
NODE_ENV=production

# خيارات Node.js (حد أقصى للذاكرة)
NODE_OPTIONS=--max-old-space-size=2048

# ============================================================================
# Python Configuration
# ============================================================================

# منع كتابة Python bytecode
PYTHONDONTWRITEBYTECODE=1

# عدم استخدام buffering في stdout/stderr
PYTHONUNBUFFERED=1

# ============================================================================
# البريد الإلكتروني (اختياري)
# ============================================================================

# خادم SMTP
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_SSL=false
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# ============================================================================
# التكامل مع الخدمات الخارجية (اختياري)
# ============================================================================

# مفتاح API (إذا كان مطلوباً)
# API_KEY=your-api-key
# API_SECRET=your-api-secret

# ============================================================================
# الميزات المتقدمة
# ============================================================================

# استخدام Sentry للمراقبة (اختياري)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345

# استخدام Bugsnag للـ Error Tracking (اختياري)
# BUGSNAG_API_KEY=your-bugsnag-key

# ============================================================================
# ملاحظات مهمة
# ============================================================================
# 1. لا تُلتزم .env في Git!
# 2. استخدم GitHub Secrets للمتغيرات الحساسة
# 3. استخدم Railway Dashboard لتعيين المتغيرات
# 4. غيّر جميع القيم الافتراضية في الإنتاج!

# ============================================================================
# كيفية استخدام هذا الملف
# ============================================================================
# 
# للتطوير المحلي:
# 1. نسخ هذا الملف: cp .env.railway.example .env
# 2. عدّل القيم حسب احتياجك
# 3. استخدم: docker-compose -f docker-compose.railway.yml up
#
# لـ Railway:
# 1. اذهب إلى Railway Dashboard
# 2. اختر مشروعك
# 3. انقر Variables
# 4. أضف كل متغير من هنا (بدون الـ #)
#
# ============================================================================