# ERPNext Docker Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
DB_NAME=erpnext
DB_USER=erpnext
DB_PASSWORD=erpnext123
DB_ROOT_PASSWORD=admin123

# Site Configuration
SITE_NAME=erp.localhost
ADMIN_PASSWORD=admin

# Redis Configuration (usually don't need to change these)
REDIS_CACHE_HOST=redis-cache
REDIS_QUEUE_HOST=redis-queue
REDIS_SOCKETIO_HOST=redis-socketio

# Email Configuration (optional)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-password

# Application Configuration
# DEVELOPER_MODE=0
# ALLOW_TESTS=0

# Timezone
# TZ=UTC

# Notes:
# - Change all passwords before deploying to production
# - SITE_NAME should be your domain name in production
# - For local development, keep erp.localhost
# - Add 127.0.0.1 erp.localhost to your /etc/hosts file for local access
