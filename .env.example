# ============================================================================
# ERPNext Kanaan ERP - Environment Configuration
# ============================================================================
# Copy this file to .env and update the values for your deployment

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=db
DB_PORT=3306
DB_NAME=kanaan_erpnext
DB_USER=erpnext
DB_PASSWORD=erpnext_secure_123
DB_ROOT_PASSWORD=kanaan_root_2024

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis Cache Server
REDIS_CACHE=redis-cache:6379
REDIS_CACHE_PORT=6379

# Redis Queue Server
REDIS_QUEUE=redis-queue:6379
REDIS_QUEUE_PORT=6380

# ============================================================================
# Frappe/ERPNext Configuration
# ============================================================================
# Site name (usually localhost or your domain)
SITE_NAME=localhost

# Environment: development, staging, production
FRAPPE_ENV=development

# Frappe Encryption Key (generate with: frappe.utils.cstr(frappe.utils.encode(os.urandom(16))))
ENCRYPTION_KEY=

# Backend Port
BACKEND_PORT=8000

# Nginx Port
NGINX_PORT=8080
NGINX_HTTPS_PORT=8443

# ============================================================================
# Node.js Configuration
# ============================================================================
NODE_ENV=production

# ============================================================================
# Application Settings
# ============================================================================
# Debug Mode (true/false)
DEBUG=false

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Max Upload Size (in MB)
MAX_UPLOAD_SIZE=25

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
# SMTP Server Settings
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SENDER_NAME=ERPNext
# SMTP_SENDER_EMAIL=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================================================
# AWS S3 Configuration (Optional)
# ============================================================================
# For storing files in S3 instead of local storage
# S3_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# ============================================================================
# Application-Specific Settings
# ============================================================================
# Company Settings
COMPANY_NAME=كنعان
COMPANY_ABBR=KANAAN

# Default Language
DEFAULT_LANGUAGE=ar

# Financial Year Start Month (1-12)
FY_START_DATE=01-01
FY_END_DATE=12-31

# ============================================================================
# Frappe Bench Configuration
# ============================================================================
FRAPPE_BENCH_PATH=/app
PYTHON_PATH=/usr/local/bin/python

# ============================================================================
# Production Settings (Use for Production Deployment)
# ============================================================================
# FRAPPE_ENV=production
# DEBUG=false
# DB_HOST=your-production-db-host
# REDIS_CACHE=your-production-redis-cache:6379
# REDIS_QUEUE=your-production-redis-queue:6379
# SITE_NAME=your-production-domain.com
# NGINX_PORT=80
# NGINX_HTTPS_PORT=443