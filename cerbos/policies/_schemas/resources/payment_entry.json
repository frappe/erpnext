{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["company", "docstatus", "owner"],
  "properties": {
    "company": { "type": "string" },
    "owner": { "type": "string" },
    "docstatus": { "type": "integer", "enum": [0, 1, 2] },
    "payment_type": { "type": "string", "enum": ["Receive", "Pay", "Internal Transfer"] },
    "country": { "type": "string" }
  }
}
