// prisma/schema.prisma
// Comprehensive Automotive Repair Workshop SaaS Platform Schema
// Includes: CRM, HRM, MAP (Maintenance & Parts), and ERP Modules

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS - Status and Type Definitions
// ============================================================================

enum OrganizationType {
  INDEPENDENT_SHOP
  FRANCHISE
  DEALERSHIP
  FLEET_MANAGEMENT
  ENTERPRISE
  MULTI_LOCATION
}

