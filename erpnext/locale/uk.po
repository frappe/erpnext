#: erpnext/accounts/doctype/sales_invoice/sales_invoice.json:2017
#: erpnext/selling/doctype/sales_order/sales_order.json:1676
msgid "Ignore Default Payment Terms Template"
msgstr "Ігнорувати шаблон умов оплати за замовчуванням"

#. Label of a Check field in DocType 'Projects Settings'
#: erpnext/projects/doctype/projects_settings/projects_settings.json:29
msgid "Ignore Employee Time Overlap"
msgstr "Ігнорувати переповнення робочого часу"

#: erpnext/stock/doctype/stock_reconciliation/stock_reconciliation.js:143
msgid "Ignore Empty Stock"
msgstr "Ігнорувати порожні залишки"

#. Label of a Check field in DocType 'Process Statement Of Accounts'
#: erpnext/accounts/doctype/process_statement_of_accounts/process_statement_of_accounts.json:381
#: erpnext/accounts/report/general_ledger/general_ledger.js:223
msgid "Ignore Exchange Rate Revaluation and Gain / Loss Journals"
msgstr "Ігнорувати журнали переоцінки курсу і курсових різниць"

#: erpnext/selling/doctype/sales_order/sales_order.js:1038
msgid "Ignore Existing Ordered Qty"
msgstr "Ігноруйте наявні впорядковані кількість"

#: erpnext/manufacturing/doctype/production_plan/production_plan.py:1787
msgid "Ignore Existing Projected Quantity"
msgstr "Ігноруйте наявну прогнозовану кількість"

#. Label of a Check field in DocType 'Accounts Settings'
#: erpnext/accounts/doctype/accounts_settings/accounts_settings.json:547
msgid "Ignore Is Opening check for reporting"
msgstr "Ігнорувати ознаку вхідних залишків у звітності"

#. Label of a Check field in DocType 'POS Invoice'
#. Label of a Check field in DocType 'POS Profile'
#. Label of a Check field in DocType 'Purchase Invoice'
