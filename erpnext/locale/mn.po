#. Content of the 'Help Text' (HTML) field in DocType 'Process Statement Of
#. Accounts'
#: erpnext/accounts/doctype/process_statement_of_accounts/process_statement_of_accounts.json
msgid ""
"<br>\n"
"<h4>Note</h4>\n"
"<ul>\n"
"<li>\n"
"You can use <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja tags</a> in <b>Subject</b> and <b>Body</b> fields for dynamic values.\n"
"</li><li>\n"
"    All fields in this doctype are available under the <b>doc</b> object and all fields for the customer to whom the mail will go to is available under the  <b>customer</b> object.\n"
"</li></ul>\n"
"<h4> Examples</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Subject</b>:<br><br><pre><code>Statement Of Accounts for {{ customer.customer_name }}</code></pre><br></li>\n"
"    <li><b>Body</b>: <br><br>\n"
"<pre><code>Hello {{ customer.customer_name }},<br>PFA your Statement Of Accounts from {{ doc.from_date }} to {{ doc.to_date }}.</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"
msgstr ""
"<br><h4>Анхаарна уу</h4><ul><li> Та динамик утгуудын хувьд <b>Subject</b> "
"болон <b>Body</b> талбарт <a "
"href=\"https://jinja.palletsprojects.com/en/2.11.x/\" "
"target=\"_blank\">Jinja хаягуудыг</a> ашиглаж болно.</li><li> Энэ баримт "
"бичгийн төрөл дэх бүх талбарууд нь <b>doc</b> объектын доор, харин захидал "
"илгээх харилцагчийн бүх талбарууд нь <b>харилцагчийн</b> объектын доор "
"байдаг.</li></ul><h4> Жишээ</h4><!-- {% raw %} --><ul><li> <b>Сэдэв</b> "
":<br><br><pre> <code>Statement Of Accounts for {{ customer.customer_name "
"}}</code></pre><br></li><li> <b>Их бие</b> :<br><br><pre> <code>Hello {{ "
"customer.customer_name }},<br> PFA your Statement Of Accounts from {{ "
"doc.from_date }} to {{ doc.to_date }}.</code></pre></li></ul><!-- {% endraw "
"%} -->"

