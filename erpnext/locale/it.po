"&lt;p&gt;Dear {{ doc.contact_person }},&lt;/p&gt;\n"
"\n"
"&lt;p&gt;Requesting payment for {{ doc.doctype }}, {{ doc.name }} for {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n"
"\n"
"</pre>\n"
msgstr "<pre><h5>Esempio di messaggio</h5>\n"
"\n"
"&lt;p&gt;Gentile {{ doc.contact_person }},&lt;/p&gt;\n"
"\n"
"&lt;p&gt;Richiesta di pagamento per {{ doc.doctype }}, {{ doc.name }} per {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
