"\n"
"&lt;p&gt;Requesting payment for {{ doc.doctype }}, {{ doc.name }} for {{ doc.grand_total }}.&lt;/p&gt;\n"
"\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n"
"\n"
"</pre>\n"
msgstr "<pre><h5>Üzenetpélda</h5>\n"
"\n"
"&lt;p&gt;Kedves {{ doc.contact_person }},&lt;/p&gt;\n"
"\n"
"&lt;p&gt;fizetési kérelem a {{ doc.doctype }}, {{ doc.name }} a {{ doc.grand_total }}számára.&lt;/p&gt;\n"
"\n"
