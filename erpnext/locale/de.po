"&lt;p&gt;Requesting payment for {{ doc.doctype }}, {{ doc.name }} for {{ doc.grand_total }}.&lt;/p&gt;\n\n"
"&lt;a href=\"{{ payment_url }}\"&gt; click here to pay &lt;/a&gt;\n\n"
"</pre>\n"
msgstr "<pre><h5>Beispiel Nachricht</h5>\n\n"
"&lt;p&gt;Lieber {{ doc.contact_person }},&lt;/p&gt;\n\n"
"&lt;p&gt;wir würden Sie bitten, die {{ doc.doctype }}, {{ doc.name }} für {{ doc.grand_total }}.&lt;/p&gt; zu begleichen.\n\n"
"&lt;a href=\"{{ payment_url }}\"&gt; Bitte klicken Sie hier zur Bezahlung &lt;/a&gt;\n\n"
"</pre>\n"

