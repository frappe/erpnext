#: erpnext/stock/doctype/serial_and_batch_bundle/serial_and_batch_bundle.py:1866
#, python-brace-format
msgid "\n"
"\t\t\tThe Batch {0} of an item {1} has negative stock in the warehouse {2}{3}.\n"
"\t\t\tPlease add a stock quantity of {4} to proceed with this entry.\n"
"\t\t\tIf it is not possible to make an adjustment entry, please enable 'Allow Negative Stock for Batch' in the batch {0} or in the Stock Settings to proceed.\n"
"\t\t\tHowever, enabling this setting may lead to negative stock in the system.\n"
"\t\t\tSo please ensure the stock levels are adjusted as soon as possible to maintain the correct valuation rate."
msgstr "\n"
"\t\t\tDie Charge {0} des Artikels {1} hat im Lager {2}{3} einen negativen Bestand.\n"
"\t\t\tBitte fügen Sie eine Bestandsmenge von {4} hinzu, um mit dieser Buchung fortzufahren.\n"
"\t\t\tWenn keine Korrekturbuchung möglich ist, aktivieren Sie bitte 'Negativen Lagerbestand zulassen' in der Charge {0} oder in den Lager-Einstellungen, um fortzufahren.\n"
"\t\t\tDas Aktivieren dieser Einstellung kann jedoch zu einem negativen Bestand im System führen.\n"
"\t\t\tBitte sorgen Sie daher so schnell wie möglich für die Anpassung der Bestände, um den korrekten Wertansatz beizubehalten."

