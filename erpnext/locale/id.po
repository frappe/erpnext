#. Content of the 'Help Text' (HTML) field in DocType 'Process Statement Of
#. Accounts'
#: erpnext/accounts/doctype/process_statement_of_accounts/process_statement_of_accounts.json:275
#, python-format
msgid ""
"<br>\n"
"<h4>Note</h4>\n"
"<ul>\n"
"<li>\n"
"You can use <a href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja tags</a> in <b>Subject</b> and <b>Body</b> fields for dynamic values.\n"
"</li><li>\n"
"    All fields in this doctype are available under the <b>doc</b> object and all fields for the customer to whom the mail will go to is available under the  <b>customer</b> object.\n"
"</li></ul>\n"
"<h4> Examples</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Subject</b>:<br><br><pre><code>Statement Of Accounts for {{ customer.customer_name }}</code></pre><br></li>\n"
"    <li><b>Body</b>: <br><br>\n"
"<pre><code>Hello {{ customer.customer_name }},<br>PFA your Statement Of Accounts from {{ doc.from_date }} to {{ doc.to_date }}.</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"
msgstr ""
"<br>\n"
"<h4>Catatan</h4>\n"
"<ul>\n"
"<li>\n"
"Anda dapat menggunakan <a <br>href=\"https://jinja.palletsprojects.com/en/2.11.x/\" target=\"_blank\">Jinja tags</a> di bidang <b>Subjek</b> dan <b>Isi</b> untuk nilai dinamis.\n"
"</li><li>\n"
"    Semua bidang pada doctype ini tersedia di bawah objek <b>doc</b> dan semua bidang untuk pelanggan yang akan menerima email tersedia di bawah objek <b>pelanggan</b>.\n"
"</li></ul>\n"
"<h4> Contoh</h4>\n"
"<!-- {% raw %} -->\n"
"<ul>\n"
"    <li><b>Subjek</b>:<br><br><pre><code>Laporan Mutasi Akun untuk {{ customer.customer_name }}</code></pre><br></li>\n"
"    <li><b>Isi</b>: <br><br>\n"
"<pre><code>Halo {{ customer.customer_name }},<br>Terlampir Laporan Mutasi Akun Anda dari {{ doc.from_date }} ke {{ doc.to_date }}.</code> </pre></li>\n"
"</ul>\n"
"<!-- {% endraw %} -->"

