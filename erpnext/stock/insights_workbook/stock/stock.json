  "stock-stock-by-item-warehouse": {
   "folder": null,
   "is_builder_query": 1,
   "is_native_query": 0,
   "is_script_query": 0,
   "name": "stock-stock-by-item-warehouse",
   "operations": [
    {
     "table": {
      "data_source": "Site DB",
      "table_name": "tabStock Ledger Entry",
      "type": "table"
     },
     "type": "source"
    },
    {
     "filters": [
      {
       "column": {
        "column_name": "is_cancelled",
        "type": "column"
       },
       "operator": "=",
       "value": 0
      },
      {
       "expression": {
        "expression": "posting_date <= today()",
        "type": "expression"
       }
      }
     ],
     "logical_operator": "And",
     "type": "filter_group"
    },
    {
     "column_names": [
      "posting_date",
      "item_code",
      "warehouse",
      "company",
      "actual_qty",
      "stock_value_difference"
     ],
     "type": "select"
    },
    {
     "dimensions": [
      {
       "column_name": "item_code",
       "data_type": "String",
       "dimension_name": "item_code"
      },
      {
       "column_name": "warehouse",
       "data_type": "String",
       "dimension_name": "warehouse"
      },
      {
       "column_name": "company",
       "data_type": "String",
       "dimension_name": "company"
      }
     ],
     "measures": [
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if(posting_date <= today(), actual_qty)",
        "type": "expression"
       },
       "measure_name": "qty_now"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if(posting_date <= date_sub(today(), 7, 'day'), actual_qty)",
        "type": "expression"
       },
       "measure_name": "qty_last_week"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if(posting_date <= date_sub(today(), 1, 'month'), actual_qty)",
        "type": "expression"
       },
       "measure_name": "qty_last_month"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if(posting_date <= today(), stock_value_difference)",
        "type": "expression"
       },
       "measure_name": "value_now"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if(posting_date <= date_sub(today(), 1, 'month'), stock_value_difference)",
        "type": "expression"
       },
       "measure_name": "value_last_month"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if((actual_qty < 0) & posting_date.between(date_sub(today(), 89, 'day'), today()), -actual_qty)",
        "type": "expression"
       },
       "measure_name": "issued_qty_rate_window"
      },
      {
       "data_type": "Date",
       "expression": {
        "expression": "max(posting_date, actual_qty < 0)",
        "type": "expression"
       },
       "measure_name": "last_issue"
      },
      {
       "data_type": "Date",
       "expression": {
        "expression": "max(posting_date, (actual_qty < 0) & (posting_date <= date_sub(today(), 1, 'month')))",
        "type": "expression"
       },
       "measure_name": "last_issue_last_month"
      }
     ],
     "type": "summarize"
    },
    {
     "data_type": "String",
     "expression": {
      "expression": "concat(item_code, '::', warehouse)",
      "type": "expression"
     },
     "new_name": "item_warehouse",
     "type": "mutate"
    },
    {
     "join_condition": {
      "left_column": {
       "column_name": "item_code",
       "type": "column"
      },
      "right_column": {
       "column_name": "name",
       "type": "column"
      }
     },
     "join_type": "inner",
     "select_columns": [
      {
       "column_name": "item_group",
       "type": "column"
      },
      {
       "column_name": "item_name",
       "type": "column"
      }
     ],
     "table": {
      "data_source": "Site DB",
      "table_name": "tabItem",
      "type": "table"
     },
     "type": "join"
    },
    {
     "join_condition": {
      "left_column": {
       "column_name": "item_warehouse",
       "type": "column"
      },
      "right_column": {
       "column_name": "item_warehouse",
       "type": "column"
      }
     },
     "join_type": "left",
     "select_columns": [
      {
       "column_name": "reorder_level",
       "type": "column"
      }
     ],
     "table": {
      "query_name": "stock-reorder-levels",
      "type": "query",
      "workbook": "stock"
     },
     "type": "join"
    },
    {
     "join_condition": {
      "left_column": {
       "column_name": "item_warehouse",
       "type": "column"
      },
      "right_column": {
       "column_name": "item_warehouse",
       "type": "column"
      }
     },
     "join_type": "left",
     "select_columns": [
      {
       "column_name": "open_po_qty",
       "type": "column"
      }
     ],
     "table": {
      "query_name": "stock-open-purchase-orders",
      "type": "query",
      "workbook": "stock"
     },
     "type": "join"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "date_diff(today(), last_issue, 'day')",
      "type": "expression"
     },
     "new_name": "days_since_last_issue",
     "type": "mutate"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "date_diff(date_sub(today(), 1, 'month'), last_issue_last_month, 'day')",
      "type": "expression"
     },
     "new_name": "days_since_last_issue_last_month",
     "type": "mutate"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "issued_qty_rate_window / 90",
      "type": "expression"
     },
     "new_name": "daily_issue",
     "type": "mutate"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "if_else(daily_issue > 0, qty_now / daily_issue, 999)",
      "type": "expression"
     },
     "new_name": "cover_days",
     "type": "mutate"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "if_else(is_set(open_po_qty), open_po_qty, 0)",
      "type": "expression"
     },
     "new_name": "open_po",
     "type": "mutate"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "one_if(is_set(reorder_level) & (qty_now <= reorder_level))",
      "type": "expression"
     },
     "new_name": "below_reorder",
     "type": "mutate"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "one_if(is_set(reorder_level) & (qty_last_week <= reorder_level))",
      "type": "expression"
     },
     "new_name": "below_reorder_last_week",
     "type": "mutate"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "one_if((qty_now <= 0) & (issued_qty_rate_window > 0))",
      "type": "expression"
     },
     "new_name": "stockout",
     "type": "mutate"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "one_if((qty_last_week <= 0) & (issued_qty_rate_window > 0))",
      "type": "expression"
     },
     "new_name": "stockout_last_week",
     "type": "mutate"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "one_if((qty_now > 0) & (days_since_last_issue > 180))",
      "type": "expression"
     },
     "new_name": "dead",
     "type": "mutate"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "one_if((qty_last_month > 0) & (days_since_last_issue_last_month > 180))",
      "type": "expression"
     },
     "new_name": "dead_last_month",
     "type": "mutate"
    },
    {
     "column_names": [
      "item_code",
      "item_name",
      "item_group",
      "warehouse",
      "company",
      "qty_now",
      "value_now",
      "value_last_month",
      "reorder_level",
      "open_po",
      "cover_days",
      "days_since_last_issue",
      "below_reorder",
      "below_reorder_last_week",
      "stockout",
      "stockout_last_week",
      "dead",
      "dead_last_month"
     ],
     "type": "select"
    }
   ],
   "sort_order": 3,
   "title": "Stock by Item & Warehouse",
   "use_live_connection": 1,
   "workbook": "stock"
  },
