    {
     "table": {
      "data_source": "Site DB",
      "table_name": "tabBin",
      "type": "table"
     },
     "type": "source"
    },
    {
     "data_type": "String",
     "expression": {
      "expression": "concat(item_code, '::', warehouse)",
      "type": "expression"
     },
     "new_name": "item_warehouse",
     "type": "mutate"
    },
    {
     "join_condition": {
      "left_column": {
       "column_name": "item_warehouse",
       "type": "column"
      },
      "right_column": {
       "column_name": "item_warehouse",
       "type": "column"
      }
     },
     "join_type": "inner",
     "select_columns": [
      {
       "column_name": "reorder_level",
       "type": "column"
      },
      {
       "column_name": "reorder_qty",
       "type": "column"
      }
     ],
     "table": {
      "query_name": "stock-reorder-levels",
      "type": "query",
      "workbook": "stock"
     },
     "type": "join"
    },
    {
     "join_condition": {
      "left_column": {
       "column_name": "item_code",
       "type": "column"
      },
      "right_column": {
       "column_name": "name",
       "type": "column"
      }
     },
     "join_type": "inner",
     "select_columns": [
      {
       "column_name": "item_name",
       "type": "column"
      },
      {
       "column_name": "is_stock_item",
       "type": "column"
      },
      {
       "column_name": "disabled",
       "type": "column"
      },
      {
       "column_name": "end_of_life",
       "type": "column"
      }
     ],
     "table": {
      "data_source": "Site DB",
      "table_name": "tabItem",
      "type": "table"
     },
     "type": "join"
    },
    {
     "filters": [
      {
       "column": {
        "column_name": "is_stock_item",
        "type": "column"
       },
       "operator": "=",
       "value": 1
      },
      {
       "column": {
        "column_name": "disabled",
        "type": "column"
       },
       "operator": "=",
       "value": 0
      },
      {
       "expression": {
        "expression": "is_not_set(end_of_life) | (end_of_life > today()) | (end_of_life.cast('string') == '0000-00-00')",
        "type": "expression"
       }
      },
      {
       "expression": {
        "expression": "(reorder_level != 0) | (reorder_qty != 0)",
        "type": "expression"
       }
      },
      {
       "expression": {
        "expression": "reorder_level > projected_qty",
        "type": "expression"
       }
      }
     ],
     "logical_operator": "And",
     "type": "filter_group"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "reorder_level - projected_qty",
      "type": "expression"
     },
     "new_name": "shortage_qty",
     "type": "mutate"
    },
    {
     "column_names": [
      "item_code",
      "item_name",
      "warehouse",
      "company",
      "actual_qty",
      "ordered_qty",
      "projected_qty",
      "reorder_level",
      "reorder_qty",
      "shortage_qty"
     ],
     "type": "select"
    },
    {
     "column": {
      "column_name": "shortage_qty",
      "type": "column"
     },
     "direction": "desc",
     "type": "order_by"
    }
   ],
