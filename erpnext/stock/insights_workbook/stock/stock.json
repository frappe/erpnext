  "stock-receipts-deliveries": {
   "folder": null,
   "is_builder_query": 1,
   "is_native_query": 0,
   "is_script_query": 0,
   "name": "stock-receipts-deliveries",
   "operations": [
    {
     "table": {
      "data_source": "Site DB",
      "table_name": "tabStock Ledger Entry",
      "type": "table"
     },
     "type": "source"
    },
    {
     "filters": [
      {
       "column": {
        "column_name": "is_cancelled",
        "type": "column"
       },
       "operator": "=",
       "value": 0
      },
      {
       "expression": {
        "expression": "posting_date <= today()",
        "type": "expression"
       }
      },
      {
       "column": {
        "column_name": "voucher_type",
        "type": "column"
       },
       "operator": "in",
       "value": [
        "Purchase Receipt",
        "Purchase Invoice",
        "Delivery Note",
        "Sales Invoice"
       ]
      }
     ],
     "logical_operator": "And",
     "type": "filter_group"
    },
    {
     "column_names": [
      "voucher_type",
      "voucher_no",
      "posting_date",
      "item_code",
      "warehouse",
      "actual_qty",
      "stock_value_difference",
      "company"
     ],
     "type": "select"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "if_else(is_in(voucher_type, 'Purchase Receipt', 'Purchase Invoice'), stock_value_difference, 0)",
      "type": "expression"
     },
     "new_name": "received_value",
     "type": "mutate"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "if_else(is_in(voucher_type, 'Delivery Note', 'Sales Invoice'), -stock_value_difference, 0)",
      "type": "expression"
     },
     "new_name": "delivered_value",
     "type": "mutate"
    }
   ],
   "sort_order": 2,
   "title": "Receipts & Deliveries",
   "use_live_connection": 1,
   "workbook": "stock"
  },
