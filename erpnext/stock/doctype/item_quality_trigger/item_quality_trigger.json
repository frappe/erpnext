   "in_list_view": 1,
   "label": "Inspection Template",
   "options": "Quality Inspection Template",
   "reqd": 1
  },
  {
   "description": "Inbound: Quarantine routes stock to a QC warehouse and locks it until release; Monitor inspects without locking. Outbound: Block stops the document until inspection passes; Warn allows with a warning; Monitor only records.",
   "fieldname": "qc_mode",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "QC Mode",
   "options": "Quarantine\nBlock\nWarn\nMonitor",
   "reqd": 1
  },
  {
   "fieldname": "column_break_insp",
