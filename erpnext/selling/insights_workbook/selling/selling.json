     "logical_operator": "And",
     "type": "filter_group"
    },
    {
     "dimensions": [],
     "measures": [
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if(transaction_date >= date_sub(week_start(today()), 91, 'day'), base_net_total) / count_if(transaction_date >= date_sub(week_start(today()), 91, 'day'))",
