       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if(transaction_date <= date_sub(week_start(today()), 92, 'day'), base_net_total) / count_if(transaction_date <= date_sub(week_start(today()), 92, 'day'))",
        "type": "expression"
       },
       "format": "currency",
       "measure_name": "aov_prior"
