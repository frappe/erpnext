 ],
 "fields": [
  {
   "fieldname": "transaction_details_section",
   "fieldtype": "Section Break",
   "label": "Transaction Details"
  },
  {
   "fieldname": "transaction_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Transaction Type",
   "options": "Issue\nTransfer\nBuyback\nRetirement\nReissue",
   "reqd": 1
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "share_class",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Share Class",
   "options": "Share Class",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "column_break_transaction_details",
   "fieldtype": "Column Break"
  },
  {
   "default": "Today",
   "fieldname": "posting_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "Posting Date",
   "reqd": 1
  },
  {
   "fetch_from": "company.default_currency",
   "fetch_if_empty": 1,
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency",
   "read_only": 1,
   "reqd": 1
  },
  {
   "depends_on": "eval:['Transfer', 'Buyback', 'Retirement', 'Reissue'].includes(doc.transaction_type)",
   "fieldname": "from_section",
   "fieldtype": "Section Break",
   "label": "From"
  },
  {
   "depends_on": "eval:['Transfer', 'Buyback'].includes(doc.transaction_type)",
   "fieldname": "from_shareholder",
   "fieldtype": "Link",
   "label": "From Shareholder",
   "mandatory_depends_on": "eval:['Transfer', 'Buyback'].includes(doc.transaction_type)",
   "options": "Shareholder"
  },
  {
   "fieldname": "column_break_from",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:['Transfer', 'Buyback', 'Retirement', 'Reissue'].includes(doc.transaction_type)",
   "fieldname": "from_folio",
   "fieldtype": "Link",
   "label": "From Folio",
   "options": "Share Folio",
   "read_only": 1
  },
  {
   "depends_on": "eval:['Issue', 'Transfer', 'Buyback', 'Reissue'].includes(doc.transaction_type)",
   "fieldname": "to_section",
   "fieldtype": "Section Break",
   "label": "To"
  },
  {
   "depends_on": "eval:['Issue', 'Transfer', 'Reissue'].includes(doc.transaction_type)",
   "fieldname": "to_shareholder",
   "fieldtype": "Link",
   "label": "To Shareholder",
   "mandatory_depends_on": "eval:['Issue', 'Transfer', 'Reissue'].includes(doc.transaction_type)",
   "options": "Shareholder"
  },
  {
   "fieldname": "column_break_to",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:['Issue', 'Transfer', 'Buyback', 'Reissue'].includes(doc.transaction_type)",
   "fieldname": "to_folio",
   "fieldtype": "Link",
   "label": "To Folio",
   "options": "Share Folio",
   "read_only": 1
  },
  {
   "fieldname": "shares_and_value_section",
   "fieldtype": "Section Break",
   "label": "Shares and Value"
  },
  {
   "fieldname": "from_share_number",
   "fieldtype": "Int",
   "label": "From Share Number",
   "reqd": 1
  },
  {
   "fieldname": "to_share_number",
   "fieldtype": "Int",
   "label": "To Share Number",
   "reqd": 1
  },
  {
   "fieldname": "number_of_shares",
   "fieldtype": "Int",
   "label": "Number of Shares",
   "read_only": 1
  },
  {
   "fieldname": "face_value_per_share",
   "fieldtype": "Currency",
   "label": "Face Value Per Share",
   "mandatory_depends_on": "eval:doc.transaction_type == 'Issue'",
   "options": "currency",
   "read_only_depends_on": "eval:doc.transaction_type != 'Issue'"
  },
  {
   "fieldname": "column_break_shares_and_value",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.transaction_type && doc.transaction_type != 'Retirement'",
   "fieldname": "rate_per_share",
   "fieldtype": "Currency",
   "label": "Rate Per Share",
   "options": "currency"
  },
  {
   "depends_on": "eval:doc.transaction_type && doc.transaction_type != 'Retirement'",
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "options": "currency",
   "read_only": 1
  },
  {
   "fieldname": "share_capital_amount",
   "fieldtype": "Currency",
   "label": "Share Capital Amount",
   "options": "currency",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "securities_premium_amount",
