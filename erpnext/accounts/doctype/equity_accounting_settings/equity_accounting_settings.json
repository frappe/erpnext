{
 "doctype": "DocType",
 "name": "Equity Accounting Settings",
 "module": "Accounts",
 "autoname": "field:company",
 "naming_rule": "By fieldname",
 "engine": "InnoDB",
 "field_order": [
  "company",
  "cash_or_bank_account",
  "share_capital_account",
  "securities_premium_account",
  "treasury_shares_account",
  "equity_adjustment_account",
  "posting_policy",
  "accounting_mode",
  "auto_submit_journal",
  "allow_treasury",
  "frozen_through"
 ],
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "cash_or_bank_account",
   "fieldtype": "Link",
   "label": "Default Settlement Account",
   "options": "Account",
   "description": "Draft Journal Entry default only. Finance must confirm payment and select the actual bank or settlement account before submitting."
  },
  {
   "fieldname": "share_capital_account",
   "fieldtype": "Link",
   "label": "Share Capital Account",
   "options": "Account"
  },
  {
   "fieldname": "securities_premium_account",
   "fieldtype": "Link",
   "label": "Securities Premium Account",
   "options": "Account"
  },
  {
   "fieldname": "treasury_shares_account",
   "fieldtype": "Link",
   "label": "Treasury Shares Account",
   "options": "Account"
  },
  {
   "fieldname": "equity_adjustment_account",
   "fieldtype": "Link",
   "label": "Equity Adjustment Account",
   "options": "Account"
  },
  {
   "fieldname": "posting_policy",
   "fieldtype": "Section Break",
   "label": "Posting Policy"
  },
  {
   "fieldname": "accounting_mode",
   "fieldtype": "Select",
   "label": "Accounting Mode",
   "options": "Clearing\nDirect",
   "default": "Direct",
   "reqd": 1,
   "description": "Direct prepares the company journal. Clearing uses an amount-due account; finance records payment with a separate Journal Entry."
  },
  {
   "fieldname": "auto_submit_journal",
   "fieldtype": "Check",
   "label": "Automatically Submit Generated Journals",
   "default": "0"
  },
  {
   "fieldname": "allow_treasury",
   "fieldtype": "Check",
   "label": "Allow Treasury Shares",
   "default": "0",
   "description": "Confirm that holding and reissuing own shares is permitted for this company."
  },
  {
   "fieldname": "frozen_through",
   "fieldtype": "Date",
   "label": "Ownership Frozen Through"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "create": 1,
   "write": 1,
   "delete": 1,
   "report": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "create": 1,
   "write": 1,
   "delete": 1,
   "report": 1
  },
  {
   "role": "Accounts User",
   "read": 1,
   "report": 1
  }
 ],
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC"
}
