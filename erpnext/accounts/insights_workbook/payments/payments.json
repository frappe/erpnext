    {
     "column_names": [
      "name"
     ],
     "type": "select"
    },
    {
     "limit": 5,
     "type": "limit"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "ibis.row_number()",
      "type": "expression"
     },
     "new_name": "row_index",
     "type": "mutate"
    },
    {
     "data_type": "Integer",
     "expression": {
      "expression": "row_index * 30 + 1",
      "type": "expression"
     },
     "new_name": "days_overdue",
     "type": "mutate"
    },
    {
     "data_type": "String",
     "expression": {
      "expression": "case(days_overdue <= 30, '1-30 Days', days_overdue <= 60, '31-60 Days', days_overdue <= 90, '61-90 Days', days_overdue <= 120, '91-120 Days', 'Over 120 Days')",
      "type": "expression"
     },
     "new_name": "age",
     "type": "mutate"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "ibis.literal(0)",
      "type": "expression"
     },
     "new_name": "overdue",
     "type": "mutate"
    },
    {
     "column_names": [
      "age",
      "overdue"
     ],
     "type": "select"
    }
   ],
