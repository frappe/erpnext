       },
       "format": "currency",
       "measure_name": "collected_last_month"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if((voucher_type == 'Sales Invoice') & (posting_date.between(month_start(today()), today())), amount)",
        "type": "expression"
       },
       "format": "currency",
       "measure_name": "billed_mtd"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if((voucher_type == 'Sales Invoice') & (posting_date.between(date_sub(month_start(today()), 1, 'month'), date_sub(today(), 1, 'month'))), amount)",
        "type": "expression"
       },
       "format": "currency",
       "measure_name": "billed_last_month"
      }
     ],
     "type": "summarize"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "collected_mtd / billed_mtd",
