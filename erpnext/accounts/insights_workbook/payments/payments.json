     },
     "type": "source"
    },
    {
     "dimensions": [],
     "measures": [
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if((voucher_type != 'Sales Invoice') & (amount < 0) & (posting_date.between(month_start(today()), today())), -amount)",
        "type": "expression"
       },
       "format": "currency",
       "measure_name": "collected_mtd"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if((voucher_type != 'Sales Invoice') & (amount < 0) & (posting_date.between(date_sub(month_start(today()), 1, 'month'), date_sub(today(), 1, 'month'))), -amount)",
