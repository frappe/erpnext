  "payments-billed-and-collected-by-week": {
   "folder": null,
   "is_builder_query": 1,
   "is_native_query": 0,
   "is_script_query": 0,
   "name": "payments-billed-and-collected-by-week",
   "operations": [
    {
     "table": {
      "query_name": "payments-receivable-ledger",
      "type": "query",
      "workbook": "payments"
     },
     "type": "source"
    },
    {
     "filters": [
      {
       "expression": {
        "expression": "posting_date.between(date_sub(week_start(today()), 91, 'day'), date_sub(week_start(today()), 1, 'day'))",
        "type": "expression"
       }
      }
     ],
     "logical_operator": "And",
     "type": "filter_group"
    },
    {
     "dimensions": [
      {
       "column_name": "posting_date",
       "data_type": "Date",
       "dimension_name": "period",
       "granularity": "week"
      }
     ],
     "measures": [
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if(voucher_type == 'Sales Invoice', amount)",
        "type": "expression"
       },
       "format": "currency",
       "measure_name": "billed"
      },
      {
       "data_type": "Decimal",
       "expression": {
        "expression": "sum_if((voucher_type != 'Sales Invoice') & (amount < 0), -amount)",
        "type": "expression"
       },
       "format": "currency",
       "measure_name": "collected"
      }
     ],
     "type": "summarize"
    },
    {
     "column": {
      "column_name": "period",
      "type": "column"
     },
     "direction": "asc",
     "type": "order_by"
    }
   ],
   "sort_order": 7,
