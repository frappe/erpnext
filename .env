# ──────────────────────────────────────────────────────────────────────────────
# ERPNext Fork – Docker Compose environment
# Copy this file to .env.local and adjust as needed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Image ─────────────────────────────────────────────────────────────────────
ERPNEXT_IMAGE=erpnext-fork
ERPNEXT_VERSION=latest

# Build args (used by `docker compose build`)
FRAPPE_BRANCH=version-17
ERPNEXT_REPO=https://github.com/fastlog-org/erpnext_test
ERPNEXT_BRANCH=develop
PAYMENTS_BRANCH=version-17

# ── Site ──────────────────────────────────────────────────────────────────────
# Add "127.0.0.1 erpnext.localhost" to /etc/hosts, or change to "localhost"
SITE_NAME=erpnext.localhost
FRAPPE_SITE_NAME_HEADER=erpnext.localhost

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_NAME=erpnext
DB_ROOT_USER=root
DB_ROOT_PASSWORD=admin

# ── Admin account ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=admin

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
REDIS_SOCKETIO=redis-socketio:6379

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2

# ── Exposed port ──────────────────────────────────────────────────────────────
HTTP_PORT=8080
